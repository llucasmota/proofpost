OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=
GEMINI_API_KEY=
# Hard timeout per LLM call (ms)
LLM_CALL_TIMEOUT_MS=120000
# RAG is optional. Set to false to skip Pinecone (the index must match gemini-embedding-001's 3072 dims).
RAG_ENABLED=true

# Model chain per role (optional — defaults live in src/config.ts). Tried left to right;
# the next entry is used only if the previous fails or runs out of quota.
# Format: gemini:<model> (direct Google API) | openrouter:<vendor/model>
# LLM_CHAIN_OPTIMIZER=gemini:gemini-2.5-flash,openrouter:google/gemini-2.5-flash
# LLM_CHAIN_ORCHESTRATOR=gemini:gemini-2.5-flash,openrouter:google/gemini-2.5-flash
# LLM_CHAIN_WRITER=gemini:gemini-3.8-flash,openrouter:google/gemini-3.8-flash
# LLM_CHAIN_REVIEWER=openrouter:anthropic/claude-sonnet-5.5,openrouter:deepseek/deepseek-v4.1-flash

# --- Research (Tavily) ---
# Without a key the run uses only your URLs/context and the local downloader.
TAVILY_API_KEY=
# auto (default): main search when you give no usable source, short complementary search otherwise.
# always: always the main search. never: no web search.
RESEARCH_SEARCH=auto
# LLM_CHAIN_RESEARCHER=gemini:gemini-2.5-flash,openrouter:google/gemini-2.5-flash,openrouter:deepseek/deepseek-v4.1-flash

# --- Topic ideas (npm run ideas) ---
IDEAS_LOOKBACK_DAYS=7
